generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  password              String
  hwid                  String?   @unique
  role                  String    @default("user")
  banned                Boolean   @default(false)
  createdAt             DateTime  @default(now())
  lastLogin             DateTime?
  lastIp                String?
  hwidResets            Int       @default(0)
  lastHwidReset         DateTime?
  inviteCode            String?   @unique
  subscriptionType      String?
  subscriptionUntil     DateTime?
  balance               Int       @default(0)
  referredBy            String?
  referralEarnings      Int       @default(0)
  lastInviteGeneratedAt DateTime?
  logs                  Log[]
  tickets               Ticket[]
  messages              Message[]
  transactions          Transaction[]
}

model Invite {
  id               String    @id @default(cuid())
  code             String    @unique
  createdBy        String?
  usedBy           String?   @unique
  usedById         String?
  usedAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  subscriptionType String    @default("none")
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ip        String?
  hwid      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Ticket {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String    @default("open")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      String
  reason    String?
  adminId   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model Status {
  id        String   @id @default("singleton")
  state     String   @default("undetected")
  message   String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Changelog {
  id        String   @id @default(cuid())
  version   String
  title     String
  body      String
  type      String   @default("update")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([published])
  @@index([createdAt])
}
